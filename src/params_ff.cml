module params_ff
import { Tensor, randn, zeros, ones, load_npy, sum } from tensor
import { sqrt } from math
import { Device, upload, download } from tiles
import { adam_leaf } from optim
export type FF = { up: Tensor<f32>, gate_w: Tensor<f32>, down: Tensor<f32> }
export type DeviceFF = { up: Device<Tensor<f32>>, gate_w: Device<Tensor<f32>>, down: Device<Tensor<f32>> }
export func initFF(): FF {
    return { up: randn([128, 512], 0.0, sqrt(1.0 / 128.0)), gate_w: randn([128, 512], 0.0, sqrt(1.0 / 128.0)), down: randn([512, 128], 0.0, sqrt(1.0 / 512.0)) }
}

export func uploadFF(p: FF): DeviceFF sync {
    return { up: upload(p.up), gate_w: upload(p.gate_w), down: upload(p.down) }
}

export func downloadFF(p: DeviceFF): FF sync {
    return { up: download(p.up), gate_w: download(p.gate_w), down: download(p.down) }
}

export func zeroFF(p: FF): FF {
    return { up: p.up * 0.0, gate_w: p.gate_w * 0.0, down: p.down * 0.0 }
}

export func loadFF(path: string): FF sync {
    return { up: load_npy(path + 'up.npy') as Tensor<f32>, gate_w: load_npy(path + 'gate_w.npy') as Tensor<f32>, down: load_npy(path + 'down.npy') as Tensor<f32> }
}

export func emaFF(p: FF, q: FF): FF {
    return { up: p.up * 0.999 + q.up * 0.001, gate_w: p.gate_w * 0.999 + q.gate_w * 0.001, down: p.down * 0.999 + q.down * 0.001 }
}

export func scaleFF(p: FF, factor: float): FF {
    return { up: p.up * factor, gate_w: p.gate_w * factor, down: p.down * factor }
}

export func normFF(p: FF): float {
    return sum(p.up * p.up) + sum(p.gate_w * p.gate_w) + sum(p.down * p.down)
}

export func distanceFF(p: FF, q: FF): float {
    return sum((p.up - q.up) * (p.up - q.up)) + sum((p.gate_w - q.gate_w) * (p.gate_w - q.gate_w)) + sum((p.down - q.down) * (p.down - q.down))
}

export func stepFF(p: FF, g: FF, m: FF, v: FF, rate: float, bc1: float, bc2: float): (FF, FF, FF) {
    let s_up = adam_leaf(p.up, g.up, m.up, v.up, rate, bc1, bc2)
    let s_gate_w = adam_leaf(p.gate_w, g.gate_w, m.gate_w, v.gate_w, rate, bc1, bc2)
    let s_down = adam_leaf(p.down, g.down, m.down, v.down, rate, bc1, bc2)
    return ({ up: s_up.0, gate_w: s_gate_w.0, down: s_down.0 }, { up: s_up.1, gate_w: s_gate_w.1, down: s_down.1 }, { up: s_up.2, gate_w: s_gate_w.2, down: s_down.2 })
}
