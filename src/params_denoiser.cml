module params_denoiser
import { Tensor, randn, zeros, ones, load_npy, sum } from tensor
import { sqrt } from math
import { Device, upload, download } from tiles
import { adam_leaf } from optim
import { Att, DeviceAtt, initAtt, uploadAtt, downloadAtt, zeroAtt, stepAtt, emaAtt, loadAtt, normAtt, scaleAtt, distanceAtt } from params_att
import { FF, DeviceFF, initFF, uploadFF, downloadFF, zeroFF, stepFF, emaFF, loadFF, normFF, scaleFF, distanceFF } from params_ff
export type Denoiser = { att: Att, cross: Att, ff: FF, n1: Tensor<f32>, n2: Tensor<f32>, n3: Tensor<f32>, time_w: Tensor<f32> }
export type DeviceDenoiser = { att: DeviceAtt, cross: DeviceAtt, ff: DeviceFF, n1: Device<Tensor<f32>>, n2: Device<Tensor<f32>>, n3: Device<Tensor<f32>>, time_w: Device<Tensor<f32>> }
export func initDenoiser(): Denoiser {
    return { att: initAtt(), cross: initAtt(), ff: initFF(), n1: ones([128]), n2: ones([128]), n3: ones([128]), time_w: randn([16, 128], 0.0, 0.02) }
}

export func uploadDenoiser(p: Denoiser): DeviceDenoiser sync {
    return { att: uploadAtt(p.att), cross: uploadAtt(p.cross), ff: uploadFF(p.ff), n1: upload(p.n1), n2: upload(p.n2), n3: upload(p.n3), time_w: upload(p.time_w) }
}

export func downloadDenoiser(p: DeviceDenoiser): Denoiser sync {
    return { att: downloadAtt(p.att), cross: downloadAtt(p.cross), ff: downloadFF(p.ff), n1: download(p.n1), n2: download(p.n2), n3: download(p.n3), time_w: download(p.time_w) }
}

export func zeroDenoiser(p: Denoiser): Denoiser {
    return { att: zeroAtt(p.att), cross: zeroAtt(p.cross), ff: zeroFF(p.ff), n1: p.n1 * 0.0, n2: p.n2 * 0.0, n3: p.n3 * 0.0, time_w: p.time_w * 0.0 }
}

export func loadDenoiser(path: string): Denoiser sync {
    return { att: loadAtt(path + 'att.'), cross: loadAtt(path + 'cross.'), ff: loadFF(path + 'ff.'), n1: load_npy(path + 'n1.npy') as Tensor<f32>, n2: load_npy(path + 'n2.npy') as Tensor<f32>, n3: load_npy(path + 'n3.npy') as Tensor<f32>, time_w: load_npy(path + 'time_w.npy') as Tensor<f32> }
}

export func emaDenoiser(p: Denoiser, q: Denoiser): Denoiser {
    return { att: emaAtt(p.att, q.att), cross: emaAtt(p.cross, q.cross), ff: emaFF(p.ff, q.ff), n1: p.n1 * 0.999 + q.n1 * 0.001, n2: p.n2 * 0.999 + q.n2 * 0.001, n3: p.n3 * 0.999 + q.n3 * 0.001, time_w: p.time_w * 0.999 + q.time_w * 0.001 }
}

export func scaleDenoiser(p: Denoiser, factor: float): Denoiser {
    return { att: scaleAtt(p.att, factor), cross: scaleAtt(p.cross, factor), ff: scaleFF(p.ff, factor), n1: p.n1 * factor, n2: p.n2 * factor, n3: p.n3 * factor, time_w: p.time_w * factor }
}

export func normDenoiser(p: Denoiser): float {
    return normAtt(p.att) + normAtt(p.cross) + normFF(p.ff) + sum(p.n1 * p.n1) + sum(p.n2 * p.n2) + sum(p.n3 * p.n3) + sum(p.time_w * p.time_w)
}

export func distanceDenoiser(p: Denoiser, q: Denoiser): float {
    return distanceAtt(p.att, q.att) + distanceAtt(p.cross, q.cross) + distanceFF(p.ff, q.ff) + sum((p.n1 - q.n1) * (p.n1 - q.n1)) + sum((p.n2 - q.n2) * (p.n2 - q.n2)) + sum((p.n3 - q.n3) * (p.n3 - q.n3)) + sum((p.time_w - q.time_w) * (p.time_w - q.time_w))
}

export func stepDenoiser(p: Denoiser, g: Denoiser, m: Denoiser, v: Denoiser, rate: float, bc1: float, bc2: float): (Denoiser, Denoiser, Denoiser) {
    let s_att = stepAtt(p.att, g.att, m.att, v.att, rate, bc1, bc2)
    let s_cross = stepAtt(p.cross, g.cross, m.cross, v.cross, rate, bc1, bc2)
    let s_ff = stepFF(p.ff, g.ff, m.ff, v.ff, rate, bc1, bc2)
    let s_n1 = adam_leaf(p.n1, g.n1, m.n1, v.n1, rate, bc1, bc2)
    let s_n2 = adam_leaf(p.n2, g.n2, m.n2, v.n2, rate, bc1, bc2)
    let s_n3 = adam_leaf(p.n3, g.n3, m.n3, v.n3, rate, bc1, bc2)
    let s_time_w = adam_leaf(p.time_w, g.time_w, m.time_w, v.time_w, rate, bc1, bc2)
    return ({ att: s_att.0, cross: s_cross.0, ff: s_ff.0, n1: s_n1.0, n2: s_n2.0, n3: s_n3.0, time_w: s_time_w.0 }, { att: s_att.1, cross: s_cross.1, ff: s_ff.1, n1: s_n1.1, n2: s_n2.1, n3: s_n3.1, time_w: s_time_w.1 }, { att: s_att.2, cross: s_cross.2, ff: s_ff.2, n1: s_n1.2, n2: s_n2.2, n3: s_n3.2, time_w: s_time_w.2 })
}
