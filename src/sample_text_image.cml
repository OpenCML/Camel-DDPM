module sample_text_image
import { Schedule, schedule, embedding, load_model } from ddpm
import { DeviceModel, upload_model } from gpu
import { forward_rgb } from text_image
import { text_features } from text_data
import { posterior } from patch_model
import { Tensor, randn, seed, save_npy, reshape, permute, set_num_threads } from tensor
import { min, max, sqrt, round } from math
import { write_text } from fs
import { from_bytes } from str
import { run } from tiles

func sample(m: DeviceModel, s: Schedule, x: Tensor<f32>, text: Tensor<f32>, empty: Tensor<f32>, guidance: float, t: int): Tensor<f32> sync {
    return if t < 0 then x else sync {
        let time = embedding(t) as Tensor<f32>
        let conditional = run<forward_rgb>((m, x, text, time))
        let predicted = if guidance == 1.0 then conditional else {
            let unconditional = run<forward_rgb>((m, x, empty, time))
            return unconditional + guidance * (conditional - unconditional)
        }
        let previous = if t == 0 then 1.0 else s.abar[t - 1]
        let mean = posterior(x, predicted, s.beta[t] * sqrt(previous) / (1.0 - s.abar[t]), (1.0 - previous) * sqrt(1.0 - s.beta[t]) / (1.0 - s.abar[t])) as Tensor<f32>
        let next = if t == 0 then mean else mean + randn([3, 64, 64]) * sqrt(s.beta[t] * (1.0 - previous) / (1.0 - s.abar[t]))
        return sample(m, s, next, text, empty, guidance, t - 1)
    }
}

func main(model: string, prompt: string, out: string, timesteps: int, sample_seed: int, guidance: float): int sync {
    set_num_threads(1)
    seed(sample_seed)
    let m = upload_model(load_model(model))
    let x = sample(m, schedule(timesteps), randn([1, 3, 64, 64]), reshape(text_features(prompt), [1, 64, 259]), reshape(text_features(''), [1, 64, 259]), guidance, timesteps - 1)
    save_npy(x, out + '.npy')
    let flat = reshape(permute(reshape(x, [3, 64, 64]), [1, 2, 0]), [12288])
    let rgb = range(0, 12288)->map<(i: int): int => int(round((min(max(flat[i], -1.0), 1.0) + 1.0) * 127.5))>
    write_text(out + '.ppm', 'P6\n64 64\n255\n' + from_bytes(rgb))
    return 0
}
