module params_att
import { Tensor, randn, zeros, ones, load_npy, sum } from tensor
import { sqrt } from math
import { Device, upload, download } from tiles
import { adam_leaf } from optim
export type Att = { q: Tensor<f32>, k: Tensor<f32>, v: Tensor<f32>, o: Tensor<f32> }
export type DeviceAtt = { q: Device<Tensor<f32>>, k: Device<Tensor<f32>>, v: Device<Tensor<f32>>, o: Device<Tensor<f32>> }
export func initAtt(): Att {
    return { q: randn([128, 128], 0.0, sqrt(1.0 / 128.0)), k: randn([128, 128], 0.0, sqrt(1.0 / 128.0)), v: randn([128, 128], 0.0, sqrt(1.0 / 128.0)), o: randn([128, 128], 0.0, sqrt(1.0 / 128.0)) }
}

export func uploadAtt(p: Att): DeviceAtt sync {
    return { q: upload(p.q), k: upload(p.k), v: upload(p.v), o: upload(p.o) }
}

export func downloadAtt(p: DeviceAtt): Att sync {
    return { q: download(p.q), k: download(p.k), v: download(p.v), o: download(p.o) }
}

export func zeroAtt(p: Att): Att {
    return { q: p.q * 0.0, k: p.k * 0.0, v: p.v * 0.0, o: p.o * 0.0 }
}

export func loadAtt(path: string): Att sync {
    return { q: load_npy(path + 'q.npy') as Tensor<f32>, k: load_npy(path + 'k.npy') as Tensor<f32>, v: load_npy(path + 'v.npy') as Tensor<f32>, o: load_npy(path + 'o.npy') as Tensor<f32> }
}

export func emaAtt(p: Att, q: Att): Att {
    return { q: p.q * 0.999 + q.q * 0.001, k: p.k * 0.999 + q.k * 0.001, v: p.v * 0.999 + q.v * 0.001, o: p.o * 0.999 + q.o * 0.001 }
}

export func scaleAtt(p: Att, factor: float): Att {
    return { q: p.q * factor, k: p.k * factor, v: p.v * factor, o: p.o * factor }
}

export func normAtt(p: Att): float {
    return sum(p.q * p.q) + sum(p.k * p.k) + sum(p.v * p.v) + sum(p.o * p.o)
}

export func distanceAtt(p: Att, q: Att): float {
    return sum((p.q - q.q) * (p.q - q.q)) + sum((p.k - q.k) * (p.k - q.k)) + sum((p.v - q.v) * (p.v - q.v)) + sum((p.o - q.o) * (p.o - q.o))
}

export func stepAtt(p: Att, g: Att, m: Att, v: Att, rate: float, bc1: float, bc2: float): (Att, Att, Att) {
    let s_q = adam_leaf(p.q, g.q, m.q, v.q, rate, bc1, bc2)
    let s_k = adam_leaf(p.k, g.k, m.k, v.k, rate, bc1, bc2)
    let s_v = adam_leaf(p.v, g.v, m.v, v.v, rate, bc1, bc2)
    let s_o = adam_leaf(p.o, g.o, m.o, v.o, rate, bc1, bc2)
    return ({ q: s_q.0, k: s_k.0, v: s_v.0, o: s_o.0 }, { q: s_q.1, k: s_k.1, v: s_v.1, o: s_o.1 }, { q: s_q.2, k: s_k.2, v: s_v.2, o: s_o.2 })
}
