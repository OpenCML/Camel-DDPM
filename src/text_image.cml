module text_image
import { Model } from ddpm
import { scaled_attention, rms_norm } from attention
import { Tensor, reshape, permute, transpose, exp, mean, randn } from tensor
import { value_and_grad } from autodiff

// RGB64 integration model, trained from random weights. Four heads and batched
// images exercise the native backend. Seven leaves reuse the verified resident
// Camel Adam. This small shared-projection network is not a production DiT.
export func init_text_image(): Model {
    return { w1: randn([192, 64], 0.0, 0.05), wt: randn([259, 64], 0.0, 0.02),
        b1: randn([64, 64], 0.0, 0.02), w2: randn([64, 64], 0.0, 0.05),
        b2: randn([64, 64], 0.0, 0.02), w3: randn([64, 192], 0.0, 0.01),
        b3: randn([16, 64], 0.0, 0.02) }
}

export func patches(x: Tensor<f32>): Tensor<f32> {
    return reshape(permute(reshape(x, [-1, 3, 8, 8, 8, 8]), [0, 2, 4, 1, 3, 5]), [-1, 64, 192])
}

export func pixels(x: Tensor<f32>): Tensor<f32> {
    return reshape(permute(reshape(x, [-1, 8, 8, 3, 8, 8]), [0, 3, 1, 4, 2, 5]), [-1, 3, 64, 64])
}

func heads(x: Tensor<f32>): Tensor<f32> {
    return permute(reshape(x, [-1, 64, 4, 16]), [0, 2, 1, 3])
}

func attend(q: Tensor<f32>, k: Tensor<f32>, v: Tensor<f32>): Tensor<f32> {
    return reshape(permute(scaled_attention(heads(q), heads(k), heads(v), 0.25), [0, 2, 1, 3]), [-1, 64, 64])
}

with <m: Model>
export func predict_rgb(noisy: Tensor<f32>, text: Tensor<f32>, time: Tensor<f32>): Tensor<f32> {
    let tokens = text @ m.wt + m.b2
    let encoded = tokens + attend(tokens, tokens, tokens)
    let image = patches(noisy) @ m.w1 + m.b1 + time @ m.b3
    let normalized = rms_norm(image, 64.0)
    let mixed = image + attend(normalized @ m.w2, encoded, encoded)
    let spatial = mixed + attend(mixed, mixed, mixed)
    let h = spatial / (1.0 + exp(-spatial))
    return pixels(h @ m.w3)
}

with <m: Model>
func loss(noisy: Tensor<f32>, text: Tensor<f32>, time: Tensor<f32>, target: Tensor<f32>): float {
    let error = predict_rgb<m>(noisy, text, time) - target
    return mean(error * error)
}

export func differentiate_rgb(m: Model, noisy: Tensor<f32>, text: Tensor<f32>, time: Tensor<f32>, target: Tensor<f32>): (float, Model) {
    return value_and_grad(loss)<m>(noisy, text, time, target)
}

export func forward_rgb(m: Model, noisy: Tensor<f32>, text: Tensor<f32>, time: Tensor<f32>): Tensor<f32> {
    return predict_rgb<m>(noisy, text, time)
}

export func average_rgb(previous: Model, current: Model): Model {
    return { w1: previous.w1 * 0.99 + current.w1 * 0.01,
        wt: previous.wt * 0.99 + current.wt * 0.01,
        b1: previous.b1 * 0.99 + current.b1 * 0.01,
        w2: previous.w2 * 0.99 + current.w2 * 0.01,
        b2: previous.b2 * 0.99 + current.b2 * 0.01,
        w3: previous.w3 * 0.99 + current.w3 * 0.01,
        b3: previous.b3 * 0.99 + current.b3 * 0.01 }
}
