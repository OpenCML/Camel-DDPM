module params_encoder
import { Tensor, randn, zeros, ones, load_npy, sum } from tensor
import { sqrt } from math
import { Device, upload, download } from tiles
import { adam_leaf } from optim
import { Att, DeviceAtt, initAtt, uploadAtt, downloadAtt, zeroAtt, stepAtt, emaAtt, loadAtt, normAtt, scaleAtt, distanceAtt } from params_att
import { FF, DeviceFF, initFF, uploadFF, downloadFF, zeroFF, stepFF, emaFF, loadFF, normFF, scaleFF, distanceFF } from params_ff
export type Encoder = { att: Att, ff: FF, n1: Tensor<f32>, n2: Tensor<f32> }
export type DeviceEncoder = { att: DeviceAtt, ff: DeviceFF, n1: Device<Tensor<f32>>, n2: Device<Tensor<f32>> }
export func initEncoder(): Encoder {
    return { att: initAtt(), ff: initFF(), n1: ones([128]), n2: ones([128]) }
}

export func uploadEncoder(p: Encoder): DeviceEncoder sync {
    return { att: uploadAtt(p.att), ff: uploadFF(p.ff), n1: upload(p.n1), n2: upload(p.n2) }
}

export func downloadEncoder(p: DeviceEncoder): Encoder sync {
    return { att: downloadAtt(p.att), ff: downloadFF(p.ff), n1: download(p.n1), n2: download(p.n2) }
}

export func zeroEncoder(p: Encoder): Encoder {
    return { att: zeroAtt(p.att), ff: zeroFF(p.ff), n1: p.n1 * 0.0, n2: p.n2 * 0.0 }
}

export func loadEncoder(path: string): Encoder sync {
    return { att: loadAtt(path + 'att.'), ff: loadFF(path + 'ff.'), n1: load_npy(path + 'n1.npy') as Tensor<f32>, n2: load_npy(path + 'n2.npy') as Tensor<f32> }
}

export func emaEncoder(p: Encoder, q: Encoder): Encoder {
    return { att: emaAtt(p.att, q.att), ff: emaFF(p.ff, q.ff), n1: p.n1 * 0.999 + q.n1 * 0.001, n2: p.n2 * 0.999 + q.n2 * 0.001 }
}

export func scaleEncoder(p: Encoder, factor: float): Encoder {
    return { att: scaleAtt(p.att, factor), ff: scaleFF(p.ff, factor), n1: p.n1 * factor, n2: p.n2 * factor }
}

export func normEncoder(p: Encoder): float {
    return normAtt(p.att) + normFF(p.ff) + sum(p.n1 * p.n1) + sum(p.n2 * p.n2)
}

export func distanceEncoder(p: Encoder, q: Encoder): float {
    return distanceAtt(p.att, q.att) + distanceFF(p.ff, q.ff) + sum((p.n1 - q.n1) * (p.n1 - q.n1)) + sum((p.n2 - q.n2) * (p.n2 - q.n2))
}

export func stepEncoder(p: Encoder, g: Encoder, m: Encoder, v: Encoder, rate: float, bc1: float, bc2: float): (Encoder, Encoder, Encoder) {
    let s_att = stepAtt(p.att, g.att, m.att, v.att, rate, bc1, bc2)
    let s_ff = stepFF(p.ff, g.ff, m.ff, v.ff, rate, bc1, bc2)
    let s_n1 = adam_leaf(p.n1, g.n1, m.n1, v.n1, rate, bc1, bc2)
    let s_n2 = adam_leaf(p.n2, g.n2, m.n2, v.n2, rate, bc1, bc2)
    return ({ att: s_att.0, ff: s_ff.0, n1: s_n1.0, n2: s_n2.0 }, { att: s_att.1, ff: s_ff.1, n1: s_n1.1, n2: s_n2.1 }, { att: s_att.2, ff: s_ff.2, n1: s_n1.2, n2: s_n2.2 })
}
