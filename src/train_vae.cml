module train_vae
import { emaAE, normAE, scaleAE, stepAE } from parameter_ops
import { zero_tree } from optim
import { Device, download, run_device, upload } from tiles
import { AE, initAE, loadAE } from parameters
import { ae_grad } from networks
import { train_batch } from latent_data
import { seed, randn, set_num_threads } from tensor
import { seed as random_seed } from random
import { read_text } from fs
import { trim, split } from str
import { save_params } from nn
import { sqrt } from math

type State = { p: Device<AE>, m: Device<AE>, v: Device<AE>, ema: Device<AE> }
func train(s: State, ids: string[], data: string, i: int, end: int, batch: int, initial_seed: int, rate: float): State sync {
    return if i == end then s else sync {
        seed(initial_seed + i + 1)
        random_seed(initial_seed + i + 1)
        let input = train_batch(ids, data, batch)
        let noise = randn([batch, 64, 4])
        let vg = run_device<ae_grad>((s.p, input.image, noise))
        let value = download(vg.0)
        let norm = sqrt(download(run_device<normAE>(vg.1)))
        if !(value >= 0.0 && value < 10000000000.0 && norm >= 0.0 && norm < 10000000000.0) then sync { println('VAE non-finite loss or gradient'); exit(1) }
        let clipped = run_device<scaleAE>((vg.1, if norm > 1.0 then 1.0 / norm else 1.0))
        let next = run_device<stepAE>((s.p, clipped, s.m, s.v, rate, 1.0 - 0.9 ^ float(i + 1), 1.0 - 0.999 ^ float(i + 1)))
        let ema = run_device<emaAE>((s.ema, next.0))
        if i % 10 == 0 || i + 1 == end then sync { println('VAE step={} loss={} grad_norm={}'->format<i + 1, value, norm>) }
        return train({ p: next.0, m: next.1, v: next.2, ema: ema }, ids, data, i + 1, end, batch, initial_seed, rate)
    }
}
func main(data: string, index: string, out: string, resume: string, start: int, end: int, batch: int, initial_seed: int, rate: float): int sync {
    set_num_threads(1)
    seed(initial_seed)
    let p = if resume == '' then initAE() else loadAE(resume + '/model/')
    let m = if resume == '' then zero_tree(p) else loadAE(resume + '/adam_m/')
    let v = if resume == '' then zero_tree(p) else loadAE(resume + '/adam_v/')
    let ema = if resume == '' then p else loadAE(resume + '/ema/')
    let ids = read_text(index)->trim->split<'\n'>
    let result = train({ p: upload(p), m: upload(m), v: upload(v), ema: upload(ema) }, ids, data, start, end, batch, initial_seed, rate)
    save_params(download(result.p), out + '/model')
    save_params(download(result.m), out + '/adam_m')
    save_params(download(result.v), out + '/adam_v')
    save_params(download(result.ema), out + '/ema')
    return 0
}
