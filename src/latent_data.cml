module latent_data
import { Tensor, reshape, concat } from tensor
import { rgb64, byte_features } from text_data
import { randint } from random
import { read_text } from fs
import { split } from str

export type Batch = { image: Tensor<f32>, text: Tensor<f32> }
func item(ids: string[], data: string, index: int, dropout: bool): Batch sync {
    let id = ids[index]
    let image = reshape(rgb64(data + '/rgb64/' + id + '.rgb'), [1, 3, 64, 64])
    let captions = read_text(data + '/rgb64/' + id + '.caption.txt')->split<'\n'>
    let selected = captions[if dropout then randint(0, len(captions) - 1) else 0]
    let caption = if dropout && randint(0, 9) == 0 then '' else selected
    return { image: image, text: reshape(byte_features(caption, 128), [1, 128, 259]) }
}
func collect(ids: string[], data: string, remaining: int, value: Batch): Batch sync {
    return if remaining == 0 then value else sync {
        let next = item(ids, data, randint(0, len(ids) - 1), true)
        return collect(ids, data, remaining - 1, { image: concat(value.image, next.image, 0), text: concat(value.text, next.text, 0) })
    }
}
export func train_batch(ids: string[], data: string, count: int): Batch sync {
    return collect(ids, data, count - 1, item(ids, data, randint(0, len(ids) - 1), true))
}
export func valid_item(ids: string[], data: string, index: int): Batch sync {
    return item(ids, data, index, false)
}
