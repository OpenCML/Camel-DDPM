+// Signatures of the binary value module; these declarations are reference metadata.
+
+/// Encodes valid UTF-8 text as an immutable Bytes value.
+/// @pure
+/// @fails fault `InvalidArgument` when legacy string content is malformed UTF-8
+/// @example encode('hello')
+inner func encode(text: string): Bytes {
+    return 'bytes:encode'
+}
+
+/// Decodes UTF-8, returning an EncodingError value for malformed input.
+/// @pure
+/// @example decode(encode('中文')) !! ''
+inner func decode(content: Bytes): string! {
+    return 'bytes:decode'
+}
+
+/// Copies integers in the inclusive range 0..255 into a binary value.
+/// @pure
+/// @fails fault `InvalidArgument` for an element outside 0..255
+/// @example from_array([0, 128, 255])
+inner func from_array(values: int[]): Bytes {
+    return 'bytes:from_array'
+}
+
+/// Copies each byte into an integer array.
+/// @pure
+/// @example to_array(encode('AB'))    // [65, 66]
+inner func to_array(content: Bytes): int[] {
+    return 'bytes:to_array'
+}
+
+/// The number of bytes in the binary value.
+/// @pure
+/// @example size(encode('abc'))    // 3
+inner func size(content: Bytes): int {
+    return 'bytes:size'
+}
+
+/// Concatenates two binary values without decoding either one.
+/// @pure
+/// @example concat(encode('header'), from_array([0, 255]))
+inner func concat(left: Bytes, right: Bytes): Bytes {
+    return 'bytes:concat'
+}
