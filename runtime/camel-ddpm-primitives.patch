diff --git a/test/cases/modules/autodiff/math_sqrt.cml b/test/cases/modules/autodiff/math_sqrt.cml
new file mode 100644
--- /dev/null
+++ b/test/cases/modules/autodiff/math_sqrt.cml
@@ -0,0 +1,23 @@
+// Scalar sqrt pullbacks, including a non-trainable integer input and a tensor coefficient.
+module math_sqrt
+import { sqrt } from math
+import { grad, value_and_grad } from autodiff
+import { Tensor, reshape, sum } from tensor
+
+func root(x: float): float { return sqrt(x) }
+func root32(x: f32): f32 { return sqrt(x) }
+func repeated(x: float): float { return sqrt(x) * sqrt(x) }
+func integer_root(n: int, x: float): float { return sqrt(n) * x }
+with <w: Tensor>
+func weighted(x: Tensor, variance: float): float { return sum(w * x * sqrt(variance)) }
+
+func main(): int sync {
+    println('sqrt64={}'->format<value_and_grad(root)(4.0)>)
+    println('sqrt32={}'->format<value_and_grad(root32)(f32(4.0))>)
+    println('repeated={}'->format<grad(repeated)(9.0)>)
+    println('integer={}'->format<grad(integer_root)(4, 3.0)>)
+    let w = reshape([1.0, 2.0], [2])
+    let x = reshape([3.0, 4.0], [2])
+    println('weighted={}'->format<value_and_grad(weighted)<w>(x, 4.0)>)
+    return 0
+}
diff --git a/test/cases/modules/fs_binary_roundtrip.cml b/test/cases/modules/fs_binary_roundtrip.cml
new file mode 100644
--- /dev/null
+++ b/test/cases/modules/fs_binary_roundtrip.cml
@@ -0,0 +1,14 @@
+// Embedded NUL and high bytes must survive the binary-mode file APIs.
+module fs_binary_roundtrip
+import { write_text, read_text, read_chunk, file_size } from fs
+import { bytes, from_bytes } from str
+import { get_env } from sys
+func main(): int sync {
+    let path = get_env('TEMP') + '/camel-fs-binary-roundtrip.bin'
+    let payload = from_bytes([0, 65, 0, 255, 13, 10, 128, 0])
+    write_text(path, payload)
+    let whole = bytes(read_text(path))
+    let middle = bytes(read_chunk(path, 1, 6))
+    println('binary size={} whole={} middle={}'->format<file_size(path), whole, middle>)
+    return if file_size(path) == 8 && len(whole) == 8 && len(middle) == 6 then 0 else 1
+}
