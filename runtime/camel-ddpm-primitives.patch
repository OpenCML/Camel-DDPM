+        const std::array<vjp_node_t, 2> divideInputs{scaled, call.output};
+        const auto dx = builder.addOper(type, narrow ? ":op/div_f" : ":op/div_d", divideInputs);
+        builder.accumulateGradient(call.inputs[0], dx);
+    }
