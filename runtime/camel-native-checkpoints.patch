+// A checkpoint is immutable: flush a private sibling directory, then publish once.
+#include "include/nn/checkpoint_io.h"
+#include <algorithm>
+#include <atomic>
+#include <cerrno>
+#include <fstream>
+#include <limits>
+#include <stdexcept>
